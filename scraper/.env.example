# Blizzard API — https://develop.battle.net/access/clients
CLIENT_ID=
CLIENT_SECRET=

# Defaults suit running `go run ./cmd/scraper` from the repository root.
DATABASE_URL=postgres://coin_catcher:coin_catcher@localhost:5432/coin_catcher?sslmode=disable

# Recipe seeding defaults: one shared 20 req/s cap and five concurrent fetchers.
# RECIPE_WORKERS may be raised to at most 8 for benchmarking.
API_REQUESTS_PER_SECOND=20
RECIPE_WORKERS=5

# Set true for an immediate snapshot; otherwise first poll starts at HH:30.
SCRAPE_ON_START=false
POLL_INTERVAL=30s
POLL_WINDOW=20m
