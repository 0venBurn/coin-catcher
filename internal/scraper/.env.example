# Blizzard API — https://develop.battle.net/access/clients
CLIENT_ID=
CLIENT_SECRET=

# Defaults suit running `go run ./cmd/scraper` from the repository root.
DATABASE_URL=postgres://coin_catcher:coin_catcher@localhost:5432/coin_catcher?sslmode=disable

# Recipe seeding defaults: one shared 20 req/s cap and five concurrent fetchers.
# RECIPE_WORKERS may be raised to at most 8 for benchmarking.
API_REQUESTS_PER_SECOND=20
RECIPE_WORKERS=5

# Polling configuration. Defaults give a continuous 24h scraper: polling
# starts as soon as the database, seeders, and Blizzard endpoints are ready,
# then repeats every POLL_WINDOW forever. Each tick polls commodity auctions
# and the WoW Token price for every region, storing rows only on change.
# POLL_START delays the first poll (e.g. 1h); POLL_END stops polling after the
# given duration since it began (e.g. 24h); both empty/0 mean no constraint.
POLL_START=0
POLL_END=0
POLL_WINDOW=30s

# TradeSkillMaster public regional item CSVs publish independently, normally
# once daily. The scraper checks each region once at startup and then on this
# separate cadence, with up to five minutes of jitter. Conditional GET state
# survives process/container restarts in PostgreSQL.
TSM_POLL_WINDOW=1h

# Optional absolute date bounds (RFC3339) for users who only want the scraper
# active during a specific period. Leave empty for unbounded.
# SCRAPE_FROM=2026-09-01T00:00:00Z
# SCRAPE_UNTIL=2026-10-01T00:00:00Z
